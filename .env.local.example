# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas or local), e.g. mongodb://127.0.0.1:27017/splitease
MONGODB_URI=

# Session encryption secret: openssl rand -base64 32
# (Auth.js v5 reads AUTH_SECRET; NEXTAUTH_SECRET is accepted as an alias)
AUTH_SECRET=
NEXTAUTH_SECRET=

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URL
NEXTAUTH_URL=http://localhost:3000
# Needed when running behind a proxy / on some hosts
AUTH_TRUST_HOST=true

# --- Demo mode (local only, never in production) ---
# Enables /api/demo-login and a "Try the demo" button on the sign-in page.
# Requires data from: node scripts/seed-demo.mjs
DEMO_MODE=false
# DEMO_USER_EMAIL=aarav@example.com
